// Klantportaal: klanten, hun projecten en supporttickets.
// Klanten worden herkend aan hun Discord user-id, zodat de OAuth2-login
// direct de juiste gegevens ophaalt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Department {
  SOFTWARE
  GAME
  MEDIA
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  REVIEW
  DELIVERED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model Customer {
  id        String    @id @default(cuid())
  discordId String    @unique
  name      String
  email     String?
  createdAt DateTime  @default(now())
  projects  Project[]
  tickets   Ticket[]

  @@index([discordId])
}

model Project {
  id         String        @id @default(cuid())
  reference  String        @unique // bijv. NS-1042
  name       String
  department Department
  status     ProjectStatus @default(PLANNED)
  progress   Int           @default(0) // 0-100
  deadline   DateTime?
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tickets    Ticket[]

  @@index([customerId])
}

model Ticket {
  id         String         @id @default(cuid())
  reference  String         @unique // bijv. T-311
  subject    String
  priority   TicketPriority @default(NORMAL)
  status     TicketStatus   @default(OPEN)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([customerId])
  @@index([projectId])
}
