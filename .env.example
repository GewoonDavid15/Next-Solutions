# Publieke URL van de site (gebruikt voor OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord server (Server Settings → Widget → "Enable Server Widget")
DISCORD_GUILD_ID=
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite

# Discord OAuth2 (https://discord.com/developers/applications)
# Redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Willekeurige lange string voor het ondertekenen van sessie-cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Optioneel: Discord webhook waar offerte-aanvragen naartoe gestuurd worden
DISCORD_CONTACT_WEBHOOK_URL=

# Database voor het klantportaal (PostgreSQL).
# Zonder deze variabele toont het portaal demo-data.
# Lokaal: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextsolutions

# Optioneel: koppelt de voorbeeldklant uit prisma/seed.ts aan jouw Discord-account
SEED_DISCORD_ID=

# Discord user-ids die toegang hebben tot /beheer, komma-gescheiden.
# Leeg laten betekent: niemand kan bij het beheerpaneel.
ADMIN_DISCORD_IDS=

# Optioneel: apart kanaal voor portaal-notificaties (nieuwe tickets, statuswijzigingen).
# Niet ingevuld? Dan wordt DISCORD_CONTACT_WEBHOOK_URL gebruikt.
DISCORD_NOTIFY_WEBHOOK_URL=
