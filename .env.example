# Publieke URL van de site (gebruikt voor OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord server (Server Settings → Widget → "Enable Server Widget")
DISCORD_GUILD_ID=
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite

# Discord OAuth2 (https://discord.com/developers/applications)
# Redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Willekeurige lange string voor het ondertekenen van sessie-cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Optioneel: Discord webhook waar offerte-aanvragen naartoe gestuurd worden
DISCORD_CONTACT_WEBHOOK_URL=

# Bot-dashboard (/dashboard)
# Jouw Discord user-ID: alleen dit account kan het bot-dashboard openen
DASHBOARD_OWNER_ID=
# Adres van de dashboard-API in je bot (IP + poort van Craftnode), zonder / aan het eind
BOT_API_URL=http://123.45.67.89:25565
# Zelfde lange willekeurige sleutel als DASHBOARD_SECRET in de .env van je bot (min. 32 tekens)
BOT_API_SECRET=
